{
  "name": "e-doc",
  "version": "2.1.0",
  "private": true,
  "description": "E-Doc Desktop",
  "author": "Khoidir Khonofi <khoidir97@gmail.com>",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "electron:compile": "tsc -p electron/tsconfig.json",
    "electron:dev": "npm run electron:compile && concurrently \"npm run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:build": "npm run build && node scripts/copy-standalone.js && npm run electron:compile && electron-builder"
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.19",
    "@fullcalendar/daygrid": "^6.1.19",
    "@fullcalendar/interaction": "^6.1.19",
    "@fullcalendar/list": "^6.1.19",
    "@fullcalendar/react": "^6.1.19",
    "@fullcalendar/timegrid": "^6.1.19",
    "@react-jvectormap/core": "^1.0.4",
    "@react-jvectormap/world": "^1.1.2",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/bcryptjs": "^2.4.6",
    "apexcharts": "^4.7.0",
    "autoprefixer": "^10.4.22",
    "bcryptjs": "^3.0.3",
    "flatpickr": "^4.6.13",
    "jose": "^6.2.9",
    "mysql2": "^3.23.3",
    "next": "^16.1.6",
    "react": "^19.2.0",
    "react-apexcharts": "^1.8.0",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^19.2.0",
    "react-dropzone": "^14.3.8",
    "swiper": "^11.2.10",
    "tailwind-merge": "^2.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@svgr/webpack": "^8.1.0",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "@types/react-transition-group": "^4.4.12",
    "concurrently": "^10.0.6",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.0.7",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "wait-on": "^9.5.1"
  },
  "overrides": {
    "@react-jvectormap/core": {
      "react": "^16.8.0 || ^17 || ^18 || ^19",
      "react-dom": "^16.8.0 || ^17 || ^18 || ^19"
    },
    "@react-jvectormap/world": {
      "react": "^16.8.0 || ^17 || ^18 || ^19",
      "react-dom": "^16.8.0 || ^17 || ^18 || ^19"
    }
  },
  "build": {
    "appId": "com.contoh.aplikasiku",
    "productName": "E-DOC",
    "files": [
      "dist-electron/**/*"
    ],
    "afterPack": "scripts/after-pack.js",
    "extraResources": [
      {
        "from": "dist-standalone",
        "to": "standalone"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "extraResources": [
    {
      "from": "dist-standalone",
      "to": "standalone",
      "filter": [
        "**/*"
      ]
    }
  ]
}